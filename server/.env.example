# Local MongoDB connection (compatible with MongoDB Compass)
# Open MongoDB Compass and connect to: mongodb://127.0.0.1:27017 or mongodb://localhost:27017
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/skillbridge
JWT_SECRET=skillbridge_local_dev_secret_key_2026
CLIENT_URL=http://localhost:5173

# Optional: If you ever want to switch to MongoDB Atlas Cloud, uncomment and use:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillbridge?retryWrites=true&w=majority
